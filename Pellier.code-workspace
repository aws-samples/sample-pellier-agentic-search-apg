      {
        "label": "Repair workshop files",
        "type": "shell",
        "command": "if [ '${input:confirmRepairWorkshopFiles}' = 'Yes, repair the files' ]; then python3 scripts/repair_workshop_files.py; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
          "cwd": "${workspaceFolder:05 - Explore Pellier source}"
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
          "clear": true,
          "showReuseMessage": false
        },
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "confirmResetLab1",
        "type": "pickString",
        "description": "Reset Lab 1 to its as-shipped start. Other labs are not touched. Choose Cancel to do nothing.",
        "options": [
          "Cancel",
          "Yes, reset Lab 1"
        ],
        "default": "Cancel"
      },
      {
