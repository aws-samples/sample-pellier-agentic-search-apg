        "command": "if [ '${input:confirmResetWholeWorkshop}' = 'Yes, reset the whole workshop' ]; then bash scripts/reset-governed-workshop.sh; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
          "cwd": "${workspaceFolder:05 - Explore Pellier source}"
