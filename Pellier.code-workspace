        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
          "clear": true,
          "showReuseMessage": false
        },
        "problemMatcher": []
      },
      {
        "label": "Reset Lab 4",
        "type": "shell",
        "command": "if [ '${input:confirmResetLab4}' = 'Yes, reset Lab 4' ]; then python3 scripts/lab_run.py reset --lab 4; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
          "cwd": "${workspaceFolder:05 - Explore Pellier source}"
