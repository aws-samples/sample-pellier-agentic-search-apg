      {
        "label": "Reset Lab 3",
        "type": "shell",
        "command": "if [ '${input:confirmResetLab3}' = 'Yes, reset Lab 3' ]; then python3 scripts/lab_run.py reset --lab 3; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
