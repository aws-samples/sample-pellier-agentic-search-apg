{
  "folders": [
    {
      "name": "01 - Retrieve",
      "path": "labs/01-retrieve"
    },
    {
      "name": "02 - Ground",
      "path": "labs/02-ground"
    },
    {
      "name": "03 - Deploy",
      "path": "labs/03-deploy"
    },
    {
      "name": "04 - Govern",
      "path": "labs/04-govern"
    },
    {
      "name": "05 - Explore Pellier source",
      "path": "."
    }
  ],
  "settings": {
    "workbench.colorTheme": "Default Dark Modern",
    "editor.fontSize": 16,
    "terminal.integrated.fontSize": 18,
    "window.zoomLevel": 1,
    "workbench.editorAssociations": {
      "**/START_HERE.md": "vscode.markdown.preview.editor"
    },
    "markdown.preview.fontSize": 16,
    "explorer.compactFolders": false,
    "explorer.sortOrder": "filesFirst",
    "terminal.integrated.cwd": "${workspaceFolder:05 - Explore Pellier source}",
    "task.allowAutomaticTasks": "on",
    "files.readonlyInclude": {
      "labs/*/solution/**": true,
      "solution/**": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/.vscode": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/dist": true,
      "logs": true,
      "tmp": true,
      "package.zip": true,
      ".workshop-ref.json": true,
      ".agentcore-project": true,
      ".local": true,
      ".worktrees": true,
      "**/.env": true,
      "**/.env.*": true,
      "**/.provision.env": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Reset Lab 1",
        "type": "shell",
        "command": "if [ '${input:confirmResetLab1}' = 'Yes, reset Lab 1' ]; then python3 scripts/lab_run.py reset --lab 1; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
          "cwd": "${workspaceFolder:05 - Explore Pellier source}"
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
          "clear": true,
          "showReuseMessage": false
        },
        "problemMatcher": []
      },
      {
        "label": "Reset Lab 2",
        "type": "shell",
        "command": "if [ '${input:confirmResetLab2}' = 'Yes, reset Lab 2' ]; then python3 scripts/lab_run.py reset --lab 2; else echo 'Cancelled. Nothing was changed.'; fi",
        "options": {
