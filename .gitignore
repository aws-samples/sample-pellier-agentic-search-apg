# Build outputs
dist/
*.log
package.zip
*_gateway_deployment.json

# Vite — local dev-server pre-bundle cache, regenerated on every
# `npm run dev`. Always project-local, never useful in the repo.
.vite/

# Database
*.db
*.sqlite

# MCP Config (auto-generated with account-specific ARNs)

# AgentCore 0.18 scaffolded project (repo-level on purpose — the CodeZip
# packager copies the whole code-location, so the project must live OUTSIDE
# pellier/backend or it packages itself recursively). Account-specific state.
.agentcore-project/


# Large data files (hosted on S3)
data/amazon-products-sample-with-embeddings.csv
data/amazon-products-sample.csv

# Test environment
tmp/
.env

# Archived files from previous workshop structure
archive/

# Embedded git repos (separate content repos)
# Lab manual / CloudFormation / prereq images live in the Workshop Studio
# repo (build-agentic-ai-powered-search-with-amazon-aurora-and-amazon-rds-builders),
# which is the source of truth for all session content.
reference/

# Playwright artifacts
pellier/frontend/playwright-report/
pellier/frontend/test-results/

# Local AI-tooling state. Previously carried only in .git/info/exclude, which is
# per-clone: on a fresh clone these appeared untracked and the release gate fails on
# untracked files in the source checkout. The hook cache also stores absolute developer
# paths, so it must never be committed.
.impeccable/
.agents/
.codex/
# Git worktrees created inside the repository path.
.worktrees/

# Generated audit bundles. Produced by a pre-handoff source audit, useful locally, and
# not a runtime or release dependency: no code may require anything under audit/.
# Promote stable handoff material into docs/ instead of committing the raw census.
audit/
