# ========================================
# Database Configuration
# ========================================
DB_HOST=your-cluster.cluster-xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-secure-password

# Database URL (alternative to individual params)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
TRANSCRIBE_REGION=us-east-1

# Aurora Cluster ARN (for RDS Data API if needed)
DB_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:pellier-cluster

# Secrets Manager (for credentials)
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:pellier-db-secret

# ========================================
# Bedrock Model IDs
# ========================================
BEDROCK_EMBEDDING_MODEL=us.cohere.embed-v4:0
BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0
# These MUST match the defaults in config.py. This file is what a local
# participant copies to .env, and env vars override the config defaults, so a
# value that drifts here silently decides which model the runtime invokes --
# past the model-access preflight, which probes the config ladder and would
# report every model reachable while the runtime called something else.
#
# Global Opus 5 -> Sonnet 5 is the editorial fallback ladder. Routing and
# reporting require Sonnet 5; Fast mode requires Haiku 4.5. The parity test
# keeps this file aligned with config.py, preflight and bootstrap.
BEDROCK_OPUS_MODEL=global.anthropic.claude-opus-5
BEDROCK_SONNET_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_ROUTER_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_REPORTING_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_CHAT_MODEL=global.anthropic.claude-opus-5

# ========================================
# API Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
# Single-process model: the built SPA + /api are served from the same
# origin (port 8000), so CORS is not strictly required for the
# workshop flow. Kept permissive for local dev-server flows (legacy
# Vite on :5173, or a separate :3000 dev proxy).
CORS_ORIGINS=["http://localhost:8000","http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# ========================================
# Cognito / AgentCore Identity
# ========================================
# Provisioned by the workshop bootstrap script or the
# .claude/prompts/infrastructure.md playbook (Req 4.1.4).
# Fill these before starting the backend so /api/auth/* endpoints work.
COGNITO_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
COGNITO_DOMAIN=pellier.auth.us-east-1.amazoncognito.com

# Storefront origin + OAuth callback (Req 3.1.1, 3.1.2, 7.2.3).
# Single-process model: the SPA is served by FastAPI on :8000, so
# APP_BASE_URL and the OAuth callback share the same origin.
APP_BASE_URL=http://localhost:8000
APP_BASE_PATH=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ========================================
# AgentCore Runtime, Memory, Gateway, Observability
# ========================================
# Provisioned by the workshop bootstrap script.
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_ARN=
AGENTCORE_GATEWAY_API_KEY=workshop
AGENTCORE_RUNTIME_ENDPOINT=

# Managed Runtime feature flag. Leave False to run the in-process Strands
# orchestrator. Flip to True when the Runtime endpoint is configured to route
# /api/agent/chat through the managed AgentCore Runtime endpoint above.
USE_AGENTCORE_RUNTIME=false

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=

# ========================================
# Bedrock Guardrails (Wire It Live / Lab 3)
# ========================================
# Guardrail resource to apply to agent input and output. Leave empty to
# run in pass-through mode (logs "guardrails disabled" at startup).
# Version defaults to DRAFT; set to a published version (e.g. "1") in prod.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
