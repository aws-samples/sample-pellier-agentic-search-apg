digraph Lab4DenyAllowSequence {
  graph [
    bgcolor="#f7f3ec",
    dpi=144,
    fontcolor="#1f1410",
    fontname="Helvetica Neue",
    fontsize=22,
    label="LAB 4: TWO LANES\nThe same staff identity and an approved review in each; only the amount changes",
    labelloc=t,
    labeljust=l,
    margin=0,
    nodesep=0.26,
    outputorder=edgesfirst,
    pad=0.28,
    ranksep="0.8 equally",
    ratio=fill,
    size="13.333,7.5!",
    splines=ortho
  ];
  node [
    color="#cbc1ad",
    fillcolor="#fbf8f2",
    fontcolor="#1f1410",
    fontname="Helvetica Neue",
    fontsize=9,
    margin="0.14,0.12",
    penwidth=1.15,
    shape=box,
    style=filled,
    width=1.65
  ];
  edge [
    arrowsize=0.68,
    fontname="Helvetica Neue",
    fontsize=8,
    penwidth=2
  ];

  subgraph cluster_deny {
    color="#991b1b";
    fillcolor="#fef2f2";
    fontcolor="#991b1b";
    fontname="Helvetica Neue";
    fontsize=13;
    label="DENY LANE: Nadia sends the over-limit review, 10001 cents";
    labeljust=l;
    margin=18;
    penwidth=1.8;
    style=filled;

    d1 [label="1 COGNITO\nverified nadia\nstaff scope"];
    d2 [label="2 CEDAR\nstaff permit matches\nyour forbid applies", color="#991b1b", fontcolor="#991b1b"];
    d3 [label="3 GATEWAY\nDENY before target", color="#991b1b", fontcolor="#991b1b"];
    d4 [label="4 LAMBDA\nNOT INVOKED", color="#991b1b", fontcolor="#991b1b"];
    d5 [label="5 AURORA\n0 tool_audit\n0 store_credits", color="#991b1b", fontcolor="#991b1b"];
    d6 [label="6 EVIDENCE\nthe desk stores the DENY\nnamed absence by key", color="#991b1b", fontcolor="#991b1b"];

    d1 -> d2 [color="#991b1b", label="claims", fontcolor="#991b1b"];
    d2 -> d3 [color="#991b1b", label="forbid", fontcolor="#991b1b"];
    d3 -> d4 [arrowhead=tee, color="#991b1b", label="blocked", fontcolor="#991b1b"];
    d4 -> d5 [arrowhead=tee, color="#991b1b", label="no transaction", fontcolor="#991b1b", style=dashed];
    d3 -> d6 [color="#991b1b", label="answer", fontcolor="#991b1b"];
    d5 -> d6 [color="#991b1b", label="prove zero", fontcolor="#991b1b", style=dashed];
    { rank=same; d1; d2; d3; d4; d5; d6; }
  }

  subgraph cluster_allow {
    color="#3f6212";
    fillcolor="#eef4e6";
    fontcolor="#3f6212";
    fontname="Helvetica Neue";
    fontsize=13;
    label="ALLOW LANE: Nadia executes Jessica's approved review, 10000 cents";
    labeljust=l;
    margin=18;
    penwidth=1.8;
    style=filled;

    a1 [label="1 COGNITO\nverified nadia\nstaff scope"];
    a2 [label="2 CEDAR\nstaff permit matches\nyour forbid exempts it", color="#3f6212", fontcolor="#3f6212"];
    a3 [label="3 GATEWAY\nALLOW bounded target", color="#3f6212", fontcolor="#3f6212"];
    a4 [label="4 LAMBDA\nexactly 1 execution", color="#3f6212", fontcolor="#3f6212"];
    a5 [label="5 APPLY_STORE_CREDIT\napproved terms and key\na retry replays it", color="#3f6212", fontcolor="#3f6212"];
    a6 [label="6 EVIDENCE\n1 tool_audit\n1 store_credits", color="#3f6212", fontcolor="#3f6212"];

    a1 -> a2 [color="#3f6212", label="claims", fontcolor="#3f6212"];
    a2 -> a3 [color="#3f6212", label="permit", fontcolor="#3f6212"];
    a3 -> a4 [color="#3f6212", label="invoke", fontcolor="#3f6212"];
    a4 -> a5 [color="#3f6212", label="transaction", fontcolor="#3f6212"];
    a5 -> a6 [color="#3f6212", label="prove exact counts", fontcolor="#3f6212"];
    { rank=same; a1; a2; a3; a4; a5; a6; }
  }

  d1 -> a1 [style=invis, weight=100];
  d2 -> a2 [style=invis, weight=100];
  d3 -> a3 [style=invis, weight=100];
  d4 -> a4 [style=invis, weight=100];
  d5 -> a5 [style=invis, weight=100];
  d6 -> a6 [style=invis, weight=100];

  checkpoint [
    label="SEPARATE FACT: Nadia's human review is not implied by either lane",
    color="#b45309",
    fillcolor="#fff7ed",
    fontcolor="#7c2d12",
    fontsize=11,
    width=5.3
  ];
  a6 -> checkpoint [
    arrowhead=none,
    color="#b45309",
    fontcolor="#b45309",
    label="do not collapse authorization, execution and approval",
    penwidth=1.3,
    style=dashed
  ];
}
