digraph Lab4JessicaGovernance {
  graph [
    bgcolor="#f7f3ec",
    dpi=144,
    fontcolor="#1f1410",
    fontname="Helvetica Neue",
    fontsize=22,
    label="LAB 4: JESSICA AND NADIA\nTwo controls on one credit, and the proof it moved once",
    labelloc=t,
    labeljust=l,
    margin=0,
    nodesep=0.34,
    outputorder=edgesfirst,
    pad=0.3,
    ranksep="0.58 equally",
    ratio=fill,
    size="13.333,7.5!",
    splines=ortho
  ];
  node [
    color="#cbc1ad",
    fillcolor="#fbf8f2",
    fontcolor="#1f1410",
    fontname="Helvetica Neue",
    fontsize=10,
    margin="0.17,0.13",
    penwidth=1.2,
    shape=box,
    style=filled,
    width=2
  ];
  edge [
    arrowsize=0.72,
    color="#9a3412",
    fontcolor="#5a2a0a",
    fontname="Helvetica Neue",
    fontsize=9,
    penwidth=2
  ];

  request [
    label="01 SHOPPER REQUEST\nJessica asks about her credit\na request carries no amount",
    fillcolor="#1f1410",
    fontcolor="#fbf8f2"
  ];
  desk [
    label="02 OPERATOR DESK\nInvestigator reads her case\nPlanner proposes 10000 cents\nfor two received returns"
  ];
  approval [
    label="03 HUMAN APPROVAL\nNadia approves the exact terms\nkey operator-review:<id>:<hash>",
    color="#b45309",
    fontcolor="#7c2d12",
    penwidth=1.8
  ];
  cognito [
    label="04 COGNITO\nNadia's token\ncustom:staff_scope = returns"
  ];
  cedar [
    label="05 CEDAR POLICY\nsupplied: give_store_credit_staff_scope\nyours: workshop_credit_limit\nunless amount_cents <= 10000",
    color="#9a3412",
    penwidth=2
  ];
  gateway [
    label="06 AGENTCORE GATEWAY\nDENY before the Lambda runs\nALLOW calls give_store_credit"
  ];
  apply [
    label="07 APPLY_STORE_CREDIT\napproved review, exact terms\nuncredited received orders\n$500 safety ceiling"
  ];
  effect [
    label="08 DURABLE EFFECT\none tool_audit row\none store_credits row\na retry replays the same credit",
    color="#3f6212",
    fontcolor="#3f6212",
    penwidth=2
  ];

  request -> desk [label="open request"];
  desk -> approval [label="one proposal"];
  approval -> cognito [label="Execute"];
  cognito -> cedar [label="verified claims"];
  cedar -> gateway [label="ALLOW or DENY"];
  gateway -> apply [label="ALLOW only"];
  apply -> effect [label="one credit per approval", color="#3f6212", fontcolor="#3f6212"];

  rls [
    label="POSTGRESQL RLS\norders_owner, support_tickets_owner\nUSING + WITH CHECK, as pellier_agent\ncustomers.cognito_username =\npellier.principal_username",
    color="#3f6212",
    fillcolor="#eef4e6",
    fontcolor="#3f6212",
    penwidth=2,
    width=3
  ];
  desk -> rls [
    label="customer reads, one name bound",
    color="#3f6212",
    fontcolor="#3f6212",
    penwidth=1.5,
    style=dashed
  ];

  deny [
    label="NEGATIVE CONTROL\nan over-limit review, 10001 cents\nDENY: 0 tool_audit, 0 store_credits\nfor its key",
    color="#991b1b",
    fillcolor="#fef2f2",
    fontcolor="#991b1b",
    penwidth=2,
    width=3
  ];
  allow [
    label="POSITIVE CONTROL\nJessica's 10000 cents\nALLOW: 1 credit, unchanged on retry",
    color="#3f6212",
    fillcolor="#eef4e6",
    fontcolor="#3f6212",
    penwidth=2,
    width=3
  ];
  cedar -> deny [
    label="your rule supplies the denial",
    color="#991b1b",
    fontcolor="#991b1b",
    penwidth=1.8
  ];
  effect -> allow [
    label="keyed counts",
    color="#3f6212",
    fontcolor="#3f6212",
    penwidth=1.8
  ];

  { rank=same; request; desk; approval; cognito; }
  { rank=same; cedar; gateway; apply; effect; }
  { rank=same; rls; deny; allow; }
}
